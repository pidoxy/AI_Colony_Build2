{
  "name": "@crs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated/schema": "./src/generated/schema.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "codegen": "kysely-codegen --dialect postgres --url \"$DATABASE_URL\" --out-file src/generated/schema.ts && pnpm exec prettier --write src/generated/schema.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "kysely": "^0.28.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8",
    "dotenv": "18.0.10",
    "kysely-codegen": "^0.18.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3"
  }
}
