# ── API ──────────────────────────────────────────────
PORT=3000
# Comma-separated allowed browser origins for CORS (web app)
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────
# Host port 55432 → container 5432 (avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://crs:crs@localhost:55432/crs

# ── Campus ───────────────────────────────────────────
# Single campus time zone (assumption A3). Grid, calendar weeks,
# opening hours and the booking horizon are computed in this zone.
CAMPUS_TZ=Africa/Lagos

# ── Auth ─────────────────────────────────────────────
# dev: tokens are unsigned JSON shaped like {"student":{"sub":"s123",...}}
# sso: verify a real OIDC id_token (set the two values below)
AUTH_MODE=dev
SSO_ISSUER=
SSO_JWKS_URI=

# ── Worker cadence (milliseconds) ────────────────────
SWEEP_INTERVAL_MS=60000
DISPATCH_INTERVAL_MS=10000

# ── Notification adapters ────────────────────────────
# log: write notifications to stdout. Replace with SMTP + Expo Push for real sends.
NOTIFICATION_ADAPTER=log
